<mxfile host="app.diagrams.net" agent="CS350 generator" version="24.7.17" type="device">
  <diagram name="Thermostat State Machine" id="thermostat-sm">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="900" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Thermostat State Machine &amp;mdash; &lt;i&gt;TemperatureMachine&lt;/i&gt; (Thermostat.py)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="1250" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="UML 2 state machine diagram &amp;middot; CS 350 Final Project (7-1) &amp;middot; Acram Kiyingi &amp;middot; October 2026 &amp;middot; python-statemachine 3.2 on Raspberry Pi 4B" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#52606d;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="52" width="1250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2933;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="92" width="990" height="790" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:16px&quot;&gt;TemperatureMachine&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#52606d&quot;&gt;attributes: setPoint : int = 72 (&amp;deg;F) &amp;middot; ledPattern &amp;middot; lastFahrenheit&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="30" y="96" width="990" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="" style="line;strokeWidth=1;html=1;strokeColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="30" y="125" width="990" height="2" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Internal transitions&lt;/b&gt; (apply in every state; the state does not change)&lt;br&gt;redButton.when_pressed &amp;nbsp;(GPIO 25) / processTempIncButton(): &lt;b&gt;setPoint += 1&lt;/b&gt;; updateLights()&lt;br&gt;blueButton.when_pressed (GPIO 12) / processTempDecButton(): &lt;b&gt;setPoint &amp;minus;= 1&lt;/b&gt;; updateLights()&lt;br&gt;greenButton.when_pressed (GPIO 24) / processTempStateButton(): send(&amp;quot;&lt;b&gt;cycle&lt;/b&gt;&amp;quot;) &amp;nbsp;&amp;rarr; drives the transitions below" style="text;html=1;align=left;verticalAlign=top;spacingLeft=14;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="990" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="" style="line;strokeWidth=1;html=1;strokeColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="30" y="206" width="990" height="2" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;i&gt;Region 1 &amp;middot; Mode control (main thread; events arrive from gpiozero button interrupts)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52606d;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="42" y="214" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="56" y="408" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;OFF&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;entry / redLight.off(); blueLight.off()&lt;br&gt;do / both LEDs off&lt;br&gt;LCD line 2, e.g. &amp;quot;OFF Set: 72F&amp;quot;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#52606d;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="120" y="365" width="290" height="112" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:15px;color:#b42318&quot;&gt;HEAT&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;entry / updateLights()&lt;br&gt;exit / redLight.off()&lt;br&gt;do / red LED &lt;b&gt;fades&lt;/b&gt; while [T &amp;lt; setPoint]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;red LED &lt;b&gt;solid&lt;/b&gt; while [T &amp;ge; setPoint]&lt;br&gt;blue LED off" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b42318;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="580" y="238" width="350" height="146" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:15px;color:#1d4ed8&quot;&gt;COOL&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;entry / updateLights()&lt;br&gt;exit / blueLight.off()&lt;br&gt;do / blue LED &lt;b&gt;fades&lt;/b&gt; while [T &amp;gt; setPoint]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;blue LED &lt;b&gt;solid&lt;/b&gt; while [T &amp;le; setPoint]&lt;br&gt;red LED off" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="580" y="470" width="350" height="146" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="" style="html=1;endArrow=open;endSize=12;strokeWidth=1.5;strokeColor=#1f2933;fontSize=13;labelBackgroundColor=#ffffff;rounded=0;fontFamily=Helvetica;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;cycle&lt;/b&gt;" style="html=1;endArrow=open;endSize=12;strokeWidth=1.5;strokeColor=#1f2933;fontSize=13;labelBackgroundColor=#ffffff;rounded=0;fontFamily=Helvetica;fontColor=#1f2933;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;cycle&lt;/b&gt;" style="html=1;endArrow=open;endSize=12;strokeWidth=1.5;strokeColor=#1f2933;fontSize=13;labelBackgroundColor=#ffffff;rounded=0;fontFamily=Helvetica;fontColor=#1f2933;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="32" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;cycle&lt;/b&gt;" style="html=1;endArrow=open;endSize=12;strokeWidth=1.5;strokeColor=#1f2933;fontSize=13;labelBackgroundColor=#ffffff;rounded=0;fontFamily=Helvetica;fontColor=#1f2933;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c11">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c18" value="On start-up the machine enters OFF with setPoint = 72." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#52606d;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="120" y="482" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="" style="line;strokeWidth=1.5;html=1;dashed=1;dashPattern=8 6;strokeColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="30" y="640" width="990" height="4" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;i&gt;Region 2 &amp;middot; Display &amp;amp; reporting (concurrent: manageMyDisplay() thread started by tsm.run(); one pass per second)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52606d;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="42" y="650" width="900" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="56" y="753" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:15px;color:#166534&quot;&gt;REPORTING&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;every 1 s / LCD line 1 = date &amp;amp; time, e.g. &amp;quot;Oct 19&amp;nbsp;&amp;nbsp;12:07:31&amp;quot;&lt;br&gt;every 1 s / LCD line 2 = &amp;quot;Temp: 70.4F&amp;quot; (seconds 1&amp;ndash;5) or &amp;quot;HEAT Set: 72F&amp;quot; (seconds 6&amp;ndash;10)&lt;br&gt;every 10 s / updateLights() &amp;nbsp;(re-checks the LED rule against the newest reading)&lt;br&gt;every 30 s / UART /dev/ttyS0 (115200 baud, 8N1) &amp;larr; &amp;quot;&lt;b&gt;state,tempF,setPoint&lt;/b&gt;\n&amp;quot;, e.g. heat,70.47,72" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf3;strokeColor=#166534;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="120" y="700" width="660" height="132" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="940" y="751" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="html=1;endArrow=open;endSize=12;strokeWidth=1.5;strokeColor=#1f2933;fontSize=13;labelBackgroundColor=#ffffff;rounded=0;fontFamily=Helvetica;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="[endDisplay] /&lt;br&gt;screen.cleanupDisplay()" style="html=1;endArrow=open;endSize=12;strokeWidth=1.5;strokeColor=#1f2933;fontSize=13;labelBackgroundColor=#ffffff;rounded=0;fontFamily=Helvetica;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;" edge="1" parent="1" source="c22" target="c23">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-22" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c26" value="Ctrl-C (KeyboardInterrupt) in the main loop sets endDisplay = True, closes the serial port and exits." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#52606d;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="795" y="790" width="215" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;Guard variables&lt;/b&gt;&lt;br&gt;&lt;b&gt;T&lt;/b&gt; = floor(current temperature in &amp;deg;F). The SHT41 sensor is read over I2C (bus 1, address 0x44) under a lock; if one read fails, the last good value is used.&lt;br&gt;&lt;b&gt;setPoint&lt;/b&gt; starts at 72 &amp;deg;F and moves 1 &amp;deg;F per button press." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#fffbea;strokeColor=#b7a14a;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="1045" y="92" width="440" height="118" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;LED rule &amp;mdash; updateLights()&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;margin-top:6px;font-size:13px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #b7a14a;padding:3px 6px;background:#f6edc4;text-align:left&quot;&gt;State&lt;/th&gt;&lt;th style=&quot;border:1px solid #b7a14a;padding:3px 6px;background:#f6edc4;text-align:left&quot;&gt;Guard&lt;/th&gt;&lt;th style=&quot;border:1px solid #b7a14a;padding:3px 6px;background:#f6edc4;text-align:left&quot;&gt;Red (GPIO 18)&lt;/th&gt;&lt;th style=&quot;border:1px solid #b7a14a;padding:3px 6px;background:#f6edc4;text-align:left&quot;&gt;Blue (GPIO 23)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;OFF&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;&amp;mdash;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;off&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;HEAT&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;T &amp;lt; setPoint&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;&lt;b&gt;fade&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;HEAT&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;T &amp;ge; setPoint&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;&lt;b&gt;solid&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;COOL&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;T &amp;gt; setPoint&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;off&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;&lt;b&gt;fade&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;COOL&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;T &amp;le; setPoint&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;off&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7a14a;padding:3px 6px&quot;&gt;&lt;b&gt;solid&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;The pattern is applied only when it changes, so a running fade is never restarted.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#fffbea;strokeColor=#b7a14a;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="1045" y="266" width="440" height="226" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;Hardware mapping (Raspberry Pi 4B, BCM numbering)&lt;/b&gt;&lt;br&gt;&amp;bull; Green button GPIO 24 &amp;rarr; cycle (off &amp;rarr; heat &amp;rarr; cool &amp;rarr; off)&lt;br&gt;&amp;bull; Red button GPIO 25 &amp;rarr; setPoint + 1&lt;br&gt;&amp;bull; Blue button GPIO 12 &amp;rarr; setPoint &amp;minus; 1&lt;br&gt;&amp;nbsp;&amp;nbsp;(gpiozero Button: internal pull-up, edge interrupt)&lt;br&gt;&amp;bull; LEDs: gpiozero PWMLED, red GPIO 18, blue GPIO 23&lt;br&gt;&amp;bull; 16&amp;times;2 LCD, 4-bit: RS 17, E 27, D4&amp;ndash;D7 = 5, 6, 13, 26&lt;br&gt;&amp;bull; Temperature: Adafruit SHT41 on I2C (replaces the kit AHT20)&lt;br&gt;&amp;bull; UART: /dev/ttyS0 (GPIO 14/15) &amp;rarr; USB-TTL cable &amp;rarr; /dev/ttyUSB0, read by ThermostatServer-Simulator.py" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#fffbea;strokeColor=#b7a14a;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="1045" y="548" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;Notation (UML 2)&lt;/b&gt;&lt;br&gt;&amp;#9679; initial state &amp;nbsp;&amp;nbsp; &amp;#9673; final state&lt;br&gt;event [guard] / action &amp;nbsp;on transitions&lt;br&gt;entry / exit / do = state behaviors&lt;br&gt;dashed line = concurrent (orthogonal) regions" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#fffbea;strokeColor=#b7a14a;fontSize=13;fontFamily=Helvetica;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="1045" y="778" width="440" height="104" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>