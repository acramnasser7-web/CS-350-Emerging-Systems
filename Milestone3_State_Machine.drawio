<mxfile host="Electron" agent="CS350 Milestone Three" version="24.7.17"><diagram id="m3-state-machine" name="CWMachine"><mxGraphModel dx="1400" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;Milestone Three: Morse Code State Machine&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#1F2933;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="c12" value="Acram Kiyingi &amp;nbsp;·&amp;nbsp; CS-350 Emerging Systems Architecture &amp;nbsp;·&amp;nbsp; Milestone3.py on Raspberry Pi 4 &amp;nbsp;·&amp;nbsp; red LED (GPIO 18) = dot, blue LED (GPIO 23) = dash, button on GPIO 24" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#1F2933;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1360" height="22" as="geometry"/></mxCell><mxCell id="c13" value="CWMachine: one state per Morse element, all routed through &lt;i&gt;off&lt;/i&gt;" style="swimlane;shape=swimlane;html=1;startSize=34;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fillColor=#323F4B;swimlaneFillColor=#FFFFFF;strokeColor=#323F4B;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="920" height="650" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;off&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;initial / idle hub&lt;br&gt;both LEDs dark&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#1F2933;strokeWidth=2.5;fillColor=#E4E7EB;align=center;verticalAlign=middle;" vertex="1" parent="c13"><mxGeometry x="380" y="290" width="160" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;dot&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:11px'&gt;entry / red LED on 500 ms&lt;br&gt;exit / red LED off&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#3E4C59;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fillColor=#FDE2E1;strokeColor=#C0392B;" vertex="1" parent="c13"><mxGeometry x="110" y="70" width="220" height="82" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;dash&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:11px'&gt;entry / blue LED on 1500 ms&lt;br&gt;exit / blue LED off&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#3E4C59;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fillColor=#DCEBFB;strokeColor=#1F5FA6;" vertex="1" parent="c13"><mxGeometry x="590" y="70" width="220" height="82" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;dotDashPause&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:11px'&gt;entry / wait 250 ms&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#3E4C59;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;dashed=0;" vertex="1" parent="c13"><mxGeometry x="30" y="290" width="190" height="72" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;wordPause&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:11px'&gt;entry / wait 3000 ms&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#3E4C59;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;dashed=0;" vertex="1" parent="c13"><mxGeometry x="700" y="290" width="190" height="72" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;letterPause&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:11px'&gt;entry / wait 750 ms&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#3E4C59;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;dashed=0;" vertex="1" parent="c13"><mxGeometry x="365" y="520" width="190" height="72" as="geometry"/></mxCell><mxCell id="c20" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="c13"><mxGeometry x="250" y="455" width="22" height="22" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;entryX=0.08;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c20" target="c14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=1.5;" vertex="1" parent="c13"><mxGeometry x="660" y="452" width="28" height="28" as="geometry"/></mxCell><mxCell id="c23" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="c13"><mxGeometry x="667" y="459" width="14" height="14" as="geometry"/></mxCell><mxCell id="c24" value="[endTransmission] after the&lt;br&gt;current pass / cleanupDisplay()" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.92;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="c13" source="c14" target="c22"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="95" y="4" as="offset"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;doDot&lt;/b&gt;&lt;br&gt;[next symbol is '.']" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c14" target="c15"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-72" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c26" value="doDot" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.42;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c15" target="c14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="6" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;doDash&lt;/b&gt;&lt;br&gt;[next symbol is '-']" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c14" target="c16"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="72" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c28" value="doDash" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.58;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c16" target="c14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-6" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;doDDP&lt;/b&gt; [more symbols&lt;br&gt;in this letter]" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.28;exitDx=0;exitDy=0;entryX=1;entryY=0.28;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c14" target="c17"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-17" as="offset"/></mxGeometry></mxCell><mxCell id="c30" value="doDDP" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.72;exitDx=0;exitDy=0;entryX=0;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c17" target="c14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;doWP&lt;/b&gt; [word or&lt;br&gt;message finished]" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.28;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c14" target="c18"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-17" as="offset"/></mxGeometry></mxCell><mxCell id="c32" value="doWP" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c18" target="c14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;doLP&lt;/b&gt;&lt;br&gt;[more letters&lt;br&gt;in this word]" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.34;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c14" target="c19"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-62" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c34" value="doLP" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.66;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="c13" source="c19" target="c14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="26" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c35" value="Every event is a two-way pair (off → X, then X → off), so each element starts and ends in &lt;i&gt;off&lt;/i&gt; with both LEDs dark. A pass of &lt;b&gt;SOS&lt;/b&gt; visits 9 symbol states, 6 dot/dash pauses, 2 letter pauses and 1 word pause: 13.5 s." style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#1F2933;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3E4C59;" vertex="1" parent="c13"><mxGeometry x="30" y="606" width="860" height="40" as="geometry"/></mxCell><mxCell id="c36" value="Message selector: green button on GPIO 24" style="swimlane;shape=swimlane;html=1;startSize=34;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fillColor=#323F4B;swimlaneFillColor=#FFFFFF;strokeColor=#323F4B;rounded=0;" vertex="1" parent="1"><mxGeometry x="960" y="84" width="420" height="300" as="geometry"/></mxCell><mxCell id="c37" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="c36"><mxGeometry x="71" y="50" width="22" height="22" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;SOS&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;message1 (default)&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#3E4C59;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fillColor=#FFF7E6;strokeColor=#B7791F;" vertex="1" parent="c36"><mxGeometry x="18" y="104" width="128" height="62" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;OK&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;message2&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;strokeColor=#3E4C59;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fillColor=#FFF7E6;strokeColor=#B7791F;" vertex="1" parent="c36"><mxGeometry x="274" y="104" width="128" height="62" as="geometry"/></mxCell><mxCell id="c40" value="" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="c36" source="c37" target="c38"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="button pressed&lt;br&gt;/ toggleMessage()" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="c36" source="c38" target="c39"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="c42" value="button pressed&lt;br&gt;/ toggleMessage()" style="endArrow=block;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#3E4C59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=10.5;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="c36" source="c39" target="c38"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="24" as="offset"/></mxGeometry></mxCell><mxCell id="c43" value="The transmit thread reads &lt;i&gt;activeMessage&lt;/i&gt; only at the start of each pass, so a press never interrupts the message being sent. The new message starts on the next pass." style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#1F2933;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3E4C59;" vertex="1" parent="c36"><mxGeometry x="24" y="214" width="380" height="60" as="geometry"/></mxCell><mxCell id="c44" value="Timing and runtime" style="swimlane;shape=swimlane;html=1;startSize=34;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fillColor=#323F4B;swimlaneFillColor=#FFFFFF;strokeColor=#323F4B;rounded=0;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="420" height="334" as="geometry"/></mxCell><mxCell id="c45" value="&lt;table style='font-size:11.5px;border-collapse:collapse;width:100%'&gt;&lt;tr&gt;&lt;td style='padding:2px 0'&gt;&lt;b&gt;Dot&lt;/b&gt; (red, GPIO 18)&lt;/td&gt;&lt;td align='right'&gt;500 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 0'&gt;&lt;b&gt;Dash&lt;/b&gt; (blue, GPIO 23)&lt;/td&gt;&lt;td align='right'&gt;1500 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 0'&gt;Between dots/dashes&lt;/td&gt;&lt;td align='right'&gt;250 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 0'&gt;Between letters&lt;/td&gt;&lt;td align='right'&gt;750 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 0'&gt;Between words / before a repeat&lt;/td&gt;&lt;td align='right' style='padding-left:12px'&gt;3000 ms&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#1F2933;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="c44"><mxGeometry x="24" y="46" width="340" height="128" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;16x2 LCD&lt;/b&gt;: shows &lt;span style='font-family:Courier'&gt;Sending:&lt;/span&gt; / &lt;span style='font-family:Courier'&gt;&amp;lt;activeMessage&amp;gt;&lt;/span&gt; at the start of every pass.&lt;br&gt;&lt;br&gt;&lt;b&gt;Threads&lt;/b&gt;: the transmit thread drives CWMachine; the gpiozero callback runs toggleMessage(); the main thread idles until Ctrl-C sets endTransmission." style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontColor=#1F2933;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;" vertex="1" parent="c44"><mxGeometry x="24" y="168" width="380" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>